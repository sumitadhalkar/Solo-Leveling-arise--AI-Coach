# GEMINI_API_KEY and GEMINI_API_KEY_2 each accept ONE key or SEVERAL — separate
# multiple keys with commas, semicolons, or newlines, in either field, in any
# combination. All of them get pooled with automatic failover, so use as many
# as you have: GEMINI_API_KEY=key1,key2,key3,key4
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_API_KEY_2=

# ── Second provider — NVIDIA NIM only ─────────────────────────────────────────
# This app supports exactly two providers: Gemini (above) and NVIDIA (below).
# The base URL is pinned in code (app/core/config.py) so this slot can't be
# silently repointed at another provider. Same multi-key rule as
# GEMINI_API_KEY applies to the _KEY fields. Leave both keys blank to run on
# Gemini alone.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_API_KEY_2=
NVIDIA_LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Optional — locks down POST /api/v1/admin/refresh-snapshot (forces a live
# Gemini Search call, so leaving it open lets anyone reach it on demand).
# Leave blank to keep that route open. If set, callers must send the same
# value as an `X-Admin-Token` header.
ADMIN_TOKEN=