GOOGLE_API_KEY=YOUR_API_KEY_HERE

# GEMINI_API_KEY and GEMINI_API_KEY_2 each accept ONE key or SEVERAL — separate
# multiple keys with commas, semicolons, or newlines, in either field, in any
# combination. All of them get pooled with automatic failover, so use as many
# as you have: GEMINI_API_KEY=key1,key2,key3,key4
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_API_KEY_2=

# ── Optional second provider — ANY OpenAI-compatible service ─────────────────
# A raw API key carries no signature saying which provider it belongs to, so
# there's no way to accept a key with zero configuration — but point BASE_URL
# at whichever provider you're using and its key works, because nearly every
# LLM provider today speaks this same chat-completions protocol: NVIDIA NIM,
# Groq, Together AI, DeepSeek, Fireworks, OpenRouter, Mistral's La Plateforme,
# a local Ollama/vLLM server, and most others. (Anthropic/Claude is the
# notable exception — different protocol, not covered by this slot.)
# Same multi-key rule as GEMINI_API_KEY applies to the _KEY fields below.
# Leave all of these blank to run on Gemini alone.
#
# Examples:
#   NVIDIA (default if BASE_URL is left blank):
#     OPENAI_COMPATIBLE_API_KEY=nvapi-xxxxxxxxxxxxxxxx
#     OPENAI_COMPATIBLE_BASE_URL=https://integrate.api.nvidia.com/v1
#     OPENAI_COMPATIBLE_MODEL=meta/llama-3.3-70b-instruct
#   Groq:
#     OPENAI_COMPATIBLE_API_KEY=gsk_xxxxxxxxxxxxxxxx
#     OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_KEY_2=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_LABEL=

# Legacy names — still work as a fallback if the OPENAI_COMPATIBLE_* fields
# above are left blank. No need to set both; new setups should use the names
# above instead, since this slot is no longer NVIDIA-specific.
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=